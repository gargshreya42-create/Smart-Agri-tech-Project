{
  "name": "smart-agri-tech",
  "version": "1.0.0",
  "private": true,
  "description": "Smart Agri-Tech — MERN smart-farming management platform",
  "scripts": {
    "install:all": "npm install --prefix server && npm install --prefix client",
    "seed": "npm run seed --prefix server",
    "server": "npm run dev --prefix server",
    "client": "npm run dev --prefix client",
    "dev": "concurrently -n api,web -c green,cyan \"npm:server\" \"npm:client\"",
    "start": "npm start --prefix server",
    "build": "npm run build --prefix client"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
