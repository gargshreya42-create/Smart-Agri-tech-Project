# Server
PORT=5000
NODE_ENV=development

# MongoDB (local example; for Atlas use your mongodb+srv:// connection string)
MONGODB_URI=mongodb://127.0.0.1:27017/agri_tech

# JWT — use a long random string, e.g. run: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Weather — optional. With an OpenWeatherMap key the API uses OpenWeatherMap;
# without one it uses the free Open-Meteo service (no key needed).
WEATHER_API_KEY=

# Allowed browser origin(s) for CORS, comma separated
CLIENT_URL=http://localhost:5173
